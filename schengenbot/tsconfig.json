{
    "compilerOptions": {
        "module": "nodenext",
        "esModuleInterop": true,
        "target": "es6",
        "noImplicitAny": false,
        "strictNullChecks": false,
        "moduleResolution": "nodenext",
        "resolveJsonModule": true,
        "sourceMap": true,
        "skipLibCheck":true,
        "outDir": "Z:/www/fgd/schengenbot/dist",
        "paths": {
            "*": [
                "./node_modules/",
                "./types/*"
            ]
        },
        "types":["node"]
    },
    "include": [
        "src/**/*.ts",
        "*.ts",
    ]
}